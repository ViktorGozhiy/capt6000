#!/bin/sh
# capt6000 -- refresh CUPS so it picks up the new backend, filter and PPD.
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

case "$1" in
    configure)
        # A freshly installed backend only shows up in "lpinfo -v" once
        # cupsd has re-scanned its backend directory.  Nudge it if running.
        if command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke try-restart cups.service >/dev/null 2>&1 || true
        elif command -v invoke-rc.d >/dev/null 2>&1; then
            invoke-rc.d cups try-restart >/dev/null 2>&1 || true
        fi
        # Load the udev rule that keeps the desktop from auto-creating a
        # generic usb:// queue for this CAPT-only printer.
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
